---
// Title, organisation and indented bullet lines; the period sits on the right.
// Consecutive entries with the same period share one label (unless shareDates={false}: every entry shows its own). If any entry has a logo, every entry
// gets a logo slot so the text lines up. A photo (image) is floated into the description: at the start of
// the second paragraph if there is one (otherwise the first), on the right.
import type { Entry } from '../data/profile';
interface Props { entries: Entry[]; shareDates?: boolean; }
const withLogos = Astro.props.entries.some((e) => e.logo);
const groups: { period: string; items: Entry[] }[] = [];
const shareDates = Astro.props.shareDates ?? true;
for (const e of Astro.props.entries) {
  const last = groups.at(-1);
  if (shareDates && last?.period === e.period) last.items.push(e); else groups.push({ period: e.period, items: [e] });
}
const photoAt = (e: Entry) => Math.min(1, (e.paragraphs?.length ?? 1) - 1);   // paragraph that holds the photo
// keepWhole: words of this entry that must not be hyphenated. Splits text so odd pieces are those words
// (the template wraps them in a span with hyphens: manual).
const whole = (e: Entry, text: string) => {
  if (!e.keepWhole?.length) return [text];
  const re = new RegExp(`\\b(${e.keepWhole.join('|')})\\b`);
  return text.split(re);
};
---
<div class="period-list">
  {groups.map((g) => (
    <div class="period-group">
      <h2 class="period-label">{g.period}</h2>
      <ul class="period-items">
        {g.items.map((e) => (
          <li class="entry" class:list={{ 'has-logo': withLogos }}>
            {withLogos && <span class="entry-logo">{e.logo && <img src={e.logo} alt="" />}</span>}
            <div class="entry-text">
            <p class="entry-title">{e.title}{e.poster && <> <a class="ref-link" href={e.poster} target="_blank" rel="noopener noreferrer">Poster</a></>}</p>
            {e.by && <p class="entry-by">{e.by}</p>}
            {e.bullets?.map((b) => <p class="entry-bullet">{b}</p>)}
            {e.paragraphs?.map((paragraph, i) => (
              <p class="entry-paragraph">
                {e.image && i === photoAt(e) ? (() => {
                  // afterWords: the photo floats in after that many words, so the first line or two run the full width above it
                  const parts = paragraph.split(/\s+/);
                  const k = Math.min(e.image.afterWords ?? 0, parts.length - 1);
                  return <>
                    {k > 0 && <>{whole(e, parts.slice(0, k).join(' ')).map((s, j) => (j % 2 ? <span class="whole">{s}</span> : s))} </>}
                    <img class="entry-photo" class:list={e.image.shape} src={e.image.src} alt={e.image.alt} loading="lazy" decoding="async" />
                    {whole(e, parts.slice(k).join(' ')).map((s, j) => (j % 2 ? <span class="whole">{s}</span> : s))}
                  </>;
                })() : whole(e, paragraph).map((s, j) => (j % 2 ? <span class="whole">{s}</span> : s))}
              </p>
            ))}
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

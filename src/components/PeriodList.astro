---
// Title, organisation and indented bullet lines; the period sits on the right.
// Consecutive entries with the same period share one label. If any entry has a logo, every entry
// gets a logo slot so the text lines up.
import type { Entry } from '../data/profile';
interface Props { entries: Entry[]; }
const withLogos = Astro.props.entries.some((e) => e.logo);
const groups: { period: string; items: Entry[] }[] = [];
for (const e of Astro.props.entries) {
  const last = groups.at(-1);
  if (last?.period === e.period) last.items.push(e); else groups.push({ period: e.period, items: [e] });
}
---
<div class="period-list">
  {groups.map((g) => (
    <div class="period-group">
      <h2 class="period-label">{g.period}</h2>
      <ul class="period-items">
        {g.items.map((e) => (
          <li class="entry" class:list={{ 'has-logo': withLogos }}>
            {withLogos && <span class="entry-logo">{e.logo && <img src={e.logo} alt="" />}</span>}
            <div class="entry-text">
            <p class="entry-title">{e.title}{e.poster && <> <a class="ref-link" href={e.poster} target="_blank" rel="noopener noreferrer">Poster</a></>}</p>
            {e.by && <p class="entry-by">{e.by}</p>}
            {e.bullets?.map((b) => <p class="entry-bullet">{b}</p>)}
            </div>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

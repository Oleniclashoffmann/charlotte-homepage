---
// A list of APA-style citations; Charlotte's name is set in bold. Entries may link to their abstract page, the published paper or their poster PDF.
import type { Ref } from '../data/profile';
interface Props { items: Ref[]; }
const { items } = Astro.props;
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const bold = (s: string) => esc(s).replace(/Sumpf, C\.( L\.)?/g, (m) => `<strong>${m}</strong>`);
const norm = (r: Ref) => (typeof r === 'string' ? { text: r } : r);
---
<ul class="refs">
  {items.map(norm).map((r) => (
    <li>
      <span set:html={bold(r.text)} />
      {r.abstract && <> <a class="ref-link" href={r.abstract}>Abstract</a></>}
      {r.paper && <> <a class="ref-link" href={r.paper} target="_blank" rel="noopener noreferrer">Paper&nbsp;↗</a></>}
      {r.poster && <> <a class="ref-link" href={r.poster} target="_blank" rel="noopener noreferrer">Poster&nbsp;↗</a></>}
    </li>
  ))}
</ul>

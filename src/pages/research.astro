---
import Base from '../layouts/Base.astro';
import Refs from '../components/Refs.astro';
import { publications, inPreparation, oralPresentations, posterPresentations } from '../data/profile';
const published = publications.map((p) => ({ text: `${p.authors} ${p.title}. ${p.venue}.`, paper: p.href || undefined }));
// One "Papers" list: published / in press / submitted first, then manuscripts marked "(in prep.)".
const papers = [...published, ...inPreparation.map((t) => t.replace(/\.$/, ' (in prep.).'))];
---
<Base title="Research">
  <h1 class="page-title">Research</h1>
  <section class="first">
    <h2>Publications</h2>
    <h3 class="sub">Papers</h3>
    <Refs items={papers} />
  </section>
  <section>
    <h2>Conference Presentations</h2>
    <h3 class="sub">Oral presentations</h3>
    <Refs items={oralPresentations} />
    <h3 class="sub">Poster presentations</h3>
    <Refs items={posterPresentations} />
  </section>
</Base>

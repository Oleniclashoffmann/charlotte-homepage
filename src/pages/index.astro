---
import Base from '../layouts/Base.astro';
import BracketLinks from '../components/BracketLinks.astro';
import { profile, publications } from '../data/profile';

const bold = (s: string) => s.replace(/Sumpf, C\.( L\.)?/g, (m) => `<strong>${m}</strong>`);
---
<Base>
  <div class="intro">
    {profile.photo && <img class="profile-image" src={profile.photo} alt={profile.name} width="112" height="112" />}
    <h1>{profile.name}</h1>
    <p>{profile.about}</p>
    <BracketLinks links={profile.links} />
  </div>

  {publications.length > 0 && (
    <section>
      <h2>Publications</h2>
      <div class="paper-list">
        {publications.map((p) => {
          const Tag = p.href ? 'a' : 'div';
          return (
            <Tag class="paper" {...(p.href ? { href: p.href, target: '_blank', rel: 'noopener noreferrer' } : {})}>
              <div>
                <h3>{p.title}</h3>
                <p class="meta" set:html={bold(p.authors)} />
                <p class="desc">{p.venue}</p>
              </div>
            </Tag>
          );
        })}
      </div>
    </section>
  )}
</Base>

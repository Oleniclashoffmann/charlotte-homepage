---
import Base from '../layouts/Base.astro';
import { profile, educationTimeline } from '../data/profile';

const initials = profile.name.split(' ').map((w) => w[0]).join('');
// "M.A., Educational Psychology (Human Development), <a>McGill University</a>, Montréal." -> degree / school
const strip = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/\.$/, '');
const LOGOS: [string, string][] = [
  ['McGill', '/img/logos/mcgill.svg'],
  ['Ludwig-Maximilians', '/img/logos/lmu.svg'],
  ['Maastricht', '/img/logos/maastricht.svg'],
];
const logoFor = (school: string) => LOGOS.find(([k]) => school.includes(k))?.[1];
const degrees = educationTimeline.flatMap((e) => {
  const [deg, field, ...rest] = strip(e.html).split(', ');
  const school = rest.join(', ');
  // Sub-entries such as the Maastricht exchange: "Exchange minor in …, <a>Maastricht University</a>."
  const subs = (e.children ?? []).filter((c) => typeof c !== 'string').map((c) => {
    const [title, ...where] = strip(c.html).split(', ');
    return { title, school: where.join(', '), period: c.period, logo: logoFor(where.join(', ')) };
  });
  return [{ title: `${deg}, ${field}`, school, period: e.period, logo: logoFor(school) }, ...subs];
});
---
<Base>
  <div class="home">
    {profile.photo
      ? <img class="home-photo" src={profile.photo} alt={profile.name} width="280" height="280" />
      : <div class="home-photo monogram" aria-hidden="true">{initials}</div>}
    <h1>{profile.name}</h1>
    <p class="home-role">{profile.role}</p>
    <p class="home-inst">{profile.institution}</p>

    <hr />
    <h2>About Me</h2>
    <p class="home-about">{profile.about}</p>

    <hr />
    <h2>Education</h2>
    <div class="home-degrees">
    {degrees.map((d) => (
      <div class="home-degree">
        {d.logo && <img class="logo" src={d.logo} alt="" width="24" height="24" loading="lazy" />}
        <div class="text">
          <p class="deg-line"><span class="deg">{d.title}</span><em class="period">{d.period}</em></p>
          <p class="school">{d.school}</p>
        </div>
      </div>
    ))}
    </div>

    <hr />
    <h2>Research Interests</h2>
    <ul class="home-interests">{profile.researchInterests.map((r) => <li>{r}</li>)}</ul>

  </div>
</Base>

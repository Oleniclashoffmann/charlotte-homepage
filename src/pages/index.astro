---
import Base from '../layouts/Base.astro';
import { profile, educationTimeline } from '../data/profile';

const initials = profile.name.split(' ').map((w) => w[0]).join('');
// "M.A., Educational Psychology (Human Development), <a>McGill University</a>, Montréal." -> degree / school
const strip = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&amp;/g, '&').replace(/\.$/, '');
const degrees = educationTimeline.map((e) => {
  const [deg, field, ...rest] = strip(e.html).split(', ');
  return { title: `${deg}, ${field}`, school: rest.join(', '), period: e.period };
});
---
<Base>
  <div class="home">
    {profile.photo
      ? <img class="home-photo" src={profile.photo} alt={profile.name} width="280" height="280" />
      : <div class="home-photo monogram" aria-hidden="true">{initials}</div>}
    <h1>{profile.name}</h1>
    <p class="home-role">{profile.role}</p>
    <p class="home-inst">{profile.institution}</p>

    <hr />
    <h2>About Me</h2>
    <p class="home-about">{profile.about}</p>

    <hr />
    <h2>Education</h2>
    {degrees.map((d) => (
      <div class="home-degree">
        <p class="deg">{d.title}</p>
        <p class="school">{d.school} — <em>{d.period}</em></p>
      </div>
    ))}

    <hr />
    <h2>Research Interests</h2>
    <ul class="home-interests">{profile.researchInterests.map((r) => <li>{r}</li>)}</ul>

  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Timeline from '../components/Timeline.astro';
import Refs from '../components/Refs.astro';
import {
  educationTimeline, researchTimeline, publications, inPreparation, oralPresentations, posterPresentations,
  awardsTimeline, teachingTimeline, outreachTimeline, reviewingTimeline, communityTimeline, skills,
} from '../data/profile';

const published = publications.map((p) => `${p.authors} ${p.title}. ${p.venue}.`);
---
<Base title="CV">
  <a class="back" href="/" aria-label="Back to home">«</a>
  <h1>CV</h1>

  <section class="cv-first"><h2>Education</h2><Timeline entries={educationTimeline} /></section>
  <section><h2>Research Experience</h2><Timeline entries={researchTimeline} /></section>

  <section>
    <h2>Publications</h2>
    <h3 class="sub">Peer-reviewed, in press &amp; submitted</h3>
    <Refs items={published} />
    <h3 class="sub">Manuscripts in preparation</h3>
    <Refs items={inPreparation} />
  </section>

  <section>
    <h2>Conference Presentations</h2>
    <h3 class="sub">Oral presentations</h3>
    <Refs items={oralPresentations} />
    <h3 class="sub">Poster presentations</h3>
    <Refs items={posterPresentations} />
  </section>

  <section><h2>Scholarships &amp; Awards</h2><Timeline entries={awardsTimeline} /></section>
  <section><h2>Teaching &amp; Supervision</h2><Timeline entries={teachingTimeline} /></section>
  <section><h2>Knowledge Translation</h2><Timeline entries={outreachTimeline} /></section>
  <section><h2>Peer Reviewing</h2><Timeline entries={reviewingTimeline} /></section>
  <section><h2>Community Involvement</h2><Timeline entries={communityTimeline} /></section>

  <section>
    <h2>Methods, Skills &amp; Languages</h2>
    <dl class="skills">
      {skills.map((s) => (<><dt>{s.group}</dt><dd set:html={s.items} /></>))}
    </dl>
  </section>
</Base>
